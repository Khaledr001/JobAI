# =============================================================================
# AI Job Hunter -- environment
# Copy to .env and fill in. NEVER commit .env. chmod 600 .env
#
# This holds credentials to a real inbox and a real CV. Read docs/PRIVACY.md
# before adding anything to it.
# =============================================================================

NODE_ENV=development
APP_TIMEZONE=Asia/Dubai   # follow-up scheduling runs on the operator's day

# -----------------------------------------------------------------------------
# Process role -- see apps/api/src/main.ts and worker.ts
#   api    HTTP only, no queue consumers
#   worker queue consumers only, no HTTP listener
#   all    both in one process (development convenience only)
# -----------------------------------------------------------------------------
PROCESS_ROLE=all

# -----------------------------------------------------------------------------
# Database (PostgreSQL 18)
# -----------------------------------------------------------------------------
# APP role. Cannot DDL, cannot promote a claim, cannot delete evidence.
DATABASE_URL=postgres://jobhunter_app:app_dev_password@localhost:5432/jobhunter

# MIGRATOR role: table owner. Migrations and seed only, never at runtime.
DATABASE_URL_MIGRATOR=postgres://jobhunter_migrator:migrator_dev_password@localhost:5432/jobhunter

DATABASE_POOL_MAX=10
DATABASE_SSL=false

# -----------------------------------------------------------------------------
# Redis (BullMQ)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
API_PORT=3001
API_PREFIX=api/v1
API_CORS_ORIGINS=http://localhost:3000
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# -----------------------------------------------------------------------------
# Operator auth -- single operator, no signup route exists.
# -----------------------------------------------------------------------------
OPERATOR_EMAIL=
OPERATOR_PASSWORD_HASH=
# tools/ingest's git scanner: comma-separated list of every git commit email
# the operator has ever used, so real work is attributed to him and nothing
# else is (e.g. an AI pairing session's own commit identity). OPERATOR_EMAIL
# above is always included automatically; list additional commit-only
# addresses (a GitHub noreply alias, an old personal address) here.
OPERATOR_GIT_EMAILS=
JWT_ACCESS_SECRET=change-me-dev-only-access-secret-min-32-chars
JWT_ACCESS_TTL=30m
JWT_REFRESH_SECRET=change-me-dev-only-refresh-secret-min-32-chars
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# LLM (DeepSeek, provider-abstracted)
# -----------------------------------------------------------------------------
# live    real API calls. Costs money.
# record  real calls, written to packages/llm/cassettes/ for replay.
# replay  no network. A cassette miss is a TEST FAILURE, not a fallthrough.
LLM_MODE=replay
LLM_PROVIDER=deepseek
LLM_MODEL_FLASH=deepseek-v4-flash
LLM_MODEL_PRO=deepseek-v4-pro
DEEPSEEK_API_KEY=
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_MS=60000
LLM_TEMPERATURE=0
LLM_SEED=1

# Hard stop, enforced before the request goes out. Set an independent cap at
# the provider dashboard too -- the in-app guard is code, and code has bugs.
LLM_DAILY_BUDGET_USD=1.00
LLM_MONTHLY_BUDGET_USD=15.00

# -----------------------------------------------------------------------------
# Job sources -- API-only by policy. LinkedIn/Bayt/GulfTalent have no
# ingestion API and no adapter here; they are reached only via apps/assist,
# manually, in a logged-in human session. See docs/DECISIONS.md.
# -----------------------------------------------------------------------------
SOURCES_ENABLED=greenhouse,lever,adzuna
GREENHOUSE_BOARDS=
LEVER_BOARDS=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=ae
SOURCES_RATE_LIMIT_PER_MIN=20

# -----------------------------------------------------------------------------
# Email -- READ-ONLY INGEST + DRAFTS ONLY. No automatic send path exists.
# -----------------------------------------------------------------------------
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_APP_PASSWORD=
IMAP_MAILBOXES=INBOX
SMTP_SEND_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=

# -----------------------------------------------------------------------------
# Object storage (generated resumes, cover letters, raw source payloads)
# -----------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=jobhunter
S3_SECRET_KEY=jobhunter_dev_password
S3_BUCKET_DOCUMENTS=jobhunter-documents
S3_BUCKET_SOURCES=jobhunter-sources
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_TTL_SECONDS=300

# -----------------------------------------------------------------------------
# Workers
# -----------------------------------------------------------------------------
WORKER_CONCURRENCY_DEFAULT=4
WORKER_CONCURRENCY_LLM=2
WORKER_CONCURRENCY_SOURCES=1

# -----------------------------------------------------------------------------
# apps/assist -- Playwright, LAPTOP ONLY. Never set on the VPS.
# -----------------------------------------------------------------------------
ASSIST_ENABLED=false
ASSIST_HEADLESS=false
PLAYWRIGHT_BROWSERS_PATH=/home/khaled/.cache/ms-playwright
ASSIST_STORAGE_STATE_DIR=./data/playwright/storage-state
ASSIST_SITE_ALLOWLIST=

# -----------------------------------------------------------------------------
# Web
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_APP_NAME=Job Hunter
